# {{APP_PATH}}/.env.testing
# System/infra values only. Copy .env.production/.env.example, then edit these.
# Do NOT put business settings here — override those per-test (see references/writing-tests.md).

NODE_ENV=testing
PORT={{DEV_PORT + 100}}
APP_GLOBAL_PREFIX={{GLOBAL_PREFIX}}
SERVICE_NAME={{APP_NAME}}
IS_SWAGGER_ENABLED=false

# --- Test database (isolated container, host port = dev port + 1) ---
POSTGRES_URL=postgresql://postgres:postgres@localhost:{{TEST_DB_PORT}}/{{DB_NAME}}_test
# MONGO_URL=mongodb://localhost:{{TEST_DB_PORT}}/{{DB_NAME}}_test

# --- Secrets — deterministic test values (>=32 chars where length is enforced) ---
AUTH_SERVICE_SECRET=test-secret-key-for-jwt-validation-min-32-chars

# --- Flags that mount test-only modules (if any) ---
# DEV_ENDPOINTS_ENABLED=true

# --- External service URLs — any localhost; mocked via overrideProvider in tests ---
FRONTEND_URLS=http://localhost:3000
